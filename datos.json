  "ponentes": [
    {
      "nombre": "Alejandro Fernández",
      "pais": "Argentina",
      "foto": "",
      "bio": "Director del centro de investigación LIFIA de la Universidad Nacional de La Plata (UNLP). Profesor Titular en la Facultad de Informática de la UNLP e Investigador Independiente en la CICPBA. Doctor por la FernUniversität Hagen (Alemania). Coordina el grupo de trabajo de Computación Cuántica del CLEI y es miembro fundador de la Red Iberoamericana para el Avance de la Ingeniería de Software Cuántico."
    },
    {
      "nombre": "Manuel Ortega",
      "pais": "España",
      "foto": "",
      "bio": "Catedrático de Universidad Castilla-La Mancha en Lenguajes y Sistemas Informáticos. Director del grupo de investigación CHICO de la UCLM entre 1991 y 2021. Coautor de más de 35 artículos en revistas indexadas, 3 libros internacionales, 13 nacionales y más de 200 publicaciones científicas."
    },
    {
      "nombre": "Enrique Moguel",
      "pais": "España",
      "foto": "",
      "bio": "Profesor Titular en la Universidad de Extremadura. Investigador del Grupo de Ingeniería de Software Quercus y del laboratorio SPILab (Laboratorio de Innovación Social y Pervasiva)."
    },
    {
      "nombre": "William Giraldo",
      "pais": "Colombia",
      "foto": "",
      "bio": "Profesor de la Universidad del Quindío. Ingeniero Electricista de la Universidad del Valle, Doctor en Informática de la Universidad Castilla-La Mancha. Líder del grupo SINFOCI."
    },
